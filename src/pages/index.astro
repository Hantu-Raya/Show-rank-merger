---
import { getGitCommitInfo } from "../gitCommitInfo.js";
import RankMergerIsland from "../components/RankMergerIsland.jsx";
import "@fontsource/jost/400.css";
import "@fontsource/jost/500.css";
import "@fontsource/jost/600.css";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "../styles/global.css";

const gitCommitInfo = getGitCommitInfo();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ShowRank + Top Bar Plus merger</title>
    <meta
      name="description"
      content="Combine ShowRank v1.0.0 and Top Bar Plus v5 for Deadlock into one VPK. Runs in your browser; files are not uploaded."
    />
    <meta name="theme-color" content="#10130d" />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <RankMergerIsland gitCommitInfo={gitCommitInfo} client:load />
  </body>
</html>
