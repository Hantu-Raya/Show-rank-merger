---
import { getGitCommitInfo } from "../gitCommitInfo.js";
import RankMergerIsland from "../components/RankMergerIsland.jsx";
import "../styles/global.css";

const gitCommitInfo = getGitCommitInfo();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Topbar Rank VPK Merger</title>
    <meta
      name="description"
      content="Build the current standalone Topbar Rank Barebones VPK from exact Top Bar Plus v40d. Choose missing-enemy alerts for the first eight minutes of native health-hidden play. Files stay on your machine."
    />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main class="app-shell">
      <RankMergerIsland gitCommitInfo={gitCommitInfo} client:load />
    </main>
  </body>
</html>
